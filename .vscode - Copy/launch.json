{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Vera: run console server",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/bot.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "PORT": "8080"
      },
      "justMyCode": true
    },
    {
      "name": "Vera: run tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "test_console.py",
        "test_bot.py",
        "-q"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ]
}
